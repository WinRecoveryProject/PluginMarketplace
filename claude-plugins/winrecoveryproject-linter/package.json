{
  "name": "@winrecoveryproject/linter",
  "version": "0.1.6",
  "description": "Read-only local source linting with explicit coverage and zero paid services",
  "type": "module",
  "license": "MIT",
  "author": "Zilvereyes",
  "homepage": "https://github.com/WinRecoveryProject/WinRecoveryProjectLinter",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WinRecoveryProject/WinRecoveryProjectLinter.git"
  },
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "wrp-lint": "scripts/wrp-lint.mjs"
  },
  "scripts": {
    "check": "node --check scripts/wrp-lint.mjs"
  },
  "files": [
    "scripts",
    "src",
    "adapters",
    "config",
    "skills",
    "commands",
    ".claude-plugin",
    "assets",
    "licenses",
    "README.md",
    "LICENSE",
    "THIRD-PARTY-NOTICES.md",
    "PRIVACY.md",
    "TERMS.md"
  ],
  "dependencies": {
    "@types/node": "24.10.1",
    "css-tree": "3.1.0",
    "js-yaml": "4.1.1",
    "jsonc-parser": "3.3.1",
    "libpg-query": "18.2.4",
    "luaparse": "0.3.1",
    "markdownlint": "0.40.0",
    "markdownlint-cli": "0.48.0",
    "parse5": "8.0.0",
    "saxes": "6.0.0",
    "smol-toml": "1.6.0",
    "typescript": "6.0.3"
  }
}
