# Plugin snapshots retain their exact source bytes and provenance hashes.
# Apply to every package, including personal imports and future additions,
# so Windows core.autocrlf cannot change their contents during checkout.
plugins/** -text
# Security patch receipts and exact-source replacements must survive Windows checkout unchanged.
remediations/** -text
claude-plugins/** -text
# Preserve the existing MIT notice bytes in the OneDrive VSIX.
editors/vscode-onedrive/LICENSE -text
