  attribute float aDuration;
  attribute float aGlyphIndex;
  attribute float aLift;
  attribute float aPhase;
  attribute float aSize;
  attribute float aTone;

  uniform float uDevicePixelRatio;
  uniform vec3 uFadeColor;
  uniform float uGlyphCount;
  uniform float uGlyphSize;
  uniform vec3 uPalette[3];
  uniform float uReducedMotion;
  uniform float uSphereRadius;
  uniform float uTime;
  uniform vec2 uViewportSize;

  varying float vAlpha;
  varying float vGlyphIndex;
  varying vec3 vColor;

  void main() {
    float time = mix(uTime / max(aDuration, 1.0), 0.0, uReducedMotion);
    float progress = fract(aPhase + time);
    float rotation = mix(
      -0.022,
      0.205,
      progress
    );
    float shellRadius = uSphereRadius + aLift;
    float perspectiveSpread = mix(1.0, 1.028, progress);
    float horizontal = position.x * uViewportSize.x * perspectiveSpread;
    float ringRadius = sqrt(
      max(shellRadius * shellRadius - horizontal * horizontal, 1.0)
    );
    vec3 shellPosition = vec3(
      horizontal,
      ringRadius * cos(rotation),
      ringRadius * sin(rotation)
    );

    float emerge = smoothstep(0.035, 0.16, progress);
    float fade = 1.0 - smoothstep(0.62, 0.96, progress);
    float limbEnergy = mix(0.84, 1.0, smoothstep(0.08, 0.24, progress));
    float liveAlpha = emerge * fade * limbEnergy;
    float stillAlpha = 0.48 + 0.36 * sin(aPhase * 6.28318530718);
    vAlpha = mix(liveAlpha, max(stillAlpha, 0.22), uReducedMotion);

    float proximityScale = mix(0.74, 1.56, progress);
    gl_PointSize = clamp(
      uGlyphSize * aSize * proximityScale * max(uDevicePixelRatio, 1.0),
      1.0,
      48.0
    );
    gl_Position = projectionMatrix * modelViewMatrix * vec4(shellPosition, 1.0);

    int tone = int(aTone + 0.5);
    vec3 toneColor = uPalette[0];
    if (tone == 1) toneColor = uPalette[1];
    else if (tone == 2) toneColor = uPalette[2];

    vec3 crestColor = mix(uPalette[2], toneColor, 0.18);
    vec3 emberColor = mix(
      uPalette[1],
      uFadeColor,
      smoothstep(0.34, 0.94, progress)
    );
    vColor = mix(crestColor, emberColor, smoothstep(0.12, 0.88, progress));

    vGlyphIndex = mod(aGlyphIndex + floor(aPhase + time), uGlyphCount);
  }
`,k=`
  uniform sampler2D uAtlas;
  uniform float uGlyphCount;

  varying float vAlpha;
  varying float vGlyphIndex;
  varying vec3 vColor;

  void main() {
    vec2 atlasUv = vec2(
      (vGlyphIndex + gl_PointCoord.x) / uGlyphCount,
      1.0 - gl_PointCoord.y
    );
    float ink = texture2D(uAtlas, atlasUv).a;
    float alpha = ink * vAlpha;

    if (alpha <= 0.025) discard;

    gl_FragColor = vec4(vColor, alpha);
  }
