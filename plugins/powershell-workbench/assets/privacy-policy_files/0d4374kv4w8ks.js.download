  vec2 remapEarthUv(vec2 uv) {
    // Preserve the scientific equirectangular projection. Composition is
    // authored by rotating the physical sphere, never by stretching or
    // repeating geography in UV space.
    // The sphere geometry duplicates vertices along the 0/1 longitude seam.
    // Preserve the raw longitude so RepeatWrapping can filter continuously
    // across that seam without introducing a fract/mod derivative break.
    return vec2(uv.x, clamp(uv.y, 0.001, 0.999));
  }

  vec4 sampleTextureDetailed(
    sampler2D textureMap,
    vec2 uv,
    vec2 texelSize,
    float lodBias,
    float detailStrength
  ) {
    vec4 center = texture2D(textureMap, uv, lodBias);
    if (detailStrength <= 0.0) return center;

    vec4 axialAverage = (
      texture2D(textureMap, uv + vec2(texelSize.x, 0.0), lodBias) +
      texture2D(textureMap, uv - vec2(texelSize.x, 0.0), lodBias) +
      texture2D(textureMap, uv + vec2(0.0, texelSize.y), lodBias) +
      texture2D(textureMap, uv - vec2(0.0, texelSize.y), lodBias)
    ) * 0.25;

    return clamp(center + (center - axialAverage) * detailStrength, 0.0, 1.0);
  }

  vec3 sampleEarthAlbedoDetailed(
    sampler2D textureMap,
    vec2 uv,
    vec2 texelSize,
    float lodBias,
    float detailStrength,
    float detailMask
  ) {
    vec3 center = texture2D(textureMap, uv, lodBias).rgb;
    vec2 uvRight = vec2(uv.x + texelSize.x, uv.y);
    vec2 uvLeft = vec2(uv.x - texelSize.x, uv.y);
    vec2 uvUp = vec2(uv.x, min(uv.y + texelSize.y, 0.999));
    vec2 uvDown = vec2(uv.x, max(uv.y - texelSize.y, 0.001));
    vec3 axialAverage = (
      texture2D(textureMap, uvRight, lodBias).rgb +
      texture2D(textureMap, uvLeft, lodBias).rgb +
      texture2D(textureMap, uvUp, lodBias).rgb +
      texture2D(textureMap, uvDown, lodBias).rgb
    ) * 0.25;

    // Adjust luminance only. Per-channel unsharp masking creates false colour
    // along coastlines after texture compression, while a restrained scalar
    // delta keeps the source chroma and photographed surface character.
    const vec3 luminanceWeights = vec3(0.2126, 0.7152, 0.0722);
    float centerLuminance = dot(center, luminanceWeights);
    float averageLuminance = dot(axialAverage, luminanceWeights);
    float localContrast = clamp(
      centerLuminance - averageLuminance,
      -0.055,
      0.055
    );
    return clamp(
      center + vec3(localContrast * detailStrength * detailMask),
      0.0,
      1.0
    );
  }

  float remapCloudDensity(float cloudSample) {
    // Preserve the fine filament field in the NASA cloud map. The previous
    // high threshold retained only storm cores, turning weather systems into
    // sparse grey decals instead of a translucent optical-depth layer.
    float wisps = smoothstep(0.035, 0.38, cloudSample) * 0.075;
    float core = pow(smoothstep(0.12, 0.76, cloudSample), 1.32);
    return clamp(wisps + core * 0.86, 0.0, 1.0);
  }
