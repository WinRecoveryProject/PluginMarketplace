.dotcom-chart-slider { display:flex;align-items:center;gap:12px;width:min(480px,100%);min-width:0;margin:0;font-size:13px;color:var(--dotcom-chart-color-foreground,var(--color-primary-100,currentColor)) }
.dotcom-chart-slider output { flex-shrink:0;font-weight:500;font-variant-numeric:tabular-nums }
.dotcom-chart-slider input { display:block;flex:1;min-width:0;width:auto;box-sizing:border-box;height:44px;padding:0;margin:0;appearance:none;background:transparent;cursor:pointer;border-radius:4px;color:inherit }
.dotcom-chart-slider input:disabled { cursor:default;opacity:.5 }
.dotcom-chart-slider input:focus-visible { outline:2px solid currentColor;outline-offset:2px }
.dotcom-chart-slider input::-webkit-slider-runnable-track { height:2px;border-radius:2px;background:linear-gradient(var(--slider-direction),currentColor var(--slider-progress),color-mix(in srgb,currentColor 12%,transparent) var(--slider-progress)) }
.dotcom-chart-slider input::-moz-range-track { height:2px;border-radius:2px;background:color-mix(in srgb,currentColor 12%,transparent) }
.dotcom-chart-slider input::-moz-range-progress { height:2px;background:currentColor }
.dotcom-chart-slider input::-webkit-slider-thumb { appearance:none;width:8px;height:8px;margin-top:-3px;border-radius:50%;background:currentColor }
.dotcom-chart-slider input::-moz-range-thumb { width:8px;height:8px;border:0;border-radius:50%;background:currentColor }
@media(pointer:coarse) { .dotcom-chart-slider input::-webkit-slider-thumb { width:14px;height:14px;margin-top:-6px } .dotcom-chart-slider input::-moz-range-thumb { width:14px;height:14px } }
@media(forced-colors:active) { .dotcom-chart-slider input { appearance:auto } }
