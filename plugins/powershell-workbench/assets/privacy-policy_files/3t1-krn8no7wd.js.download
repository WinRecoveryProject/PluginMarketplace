      [data-dotcom-chart-data-view] dialog { box-sizing: border-box; width: min(720px, calc(100vw - 32px)); max-width: calc(100vw - 32px); margin: auto; max-height: calc(100dvh - 32px); padding: 20px; border: 1px solid var(--dotcom-chart-color-control-border, #8886); border-radius: 16px; color: var(--dotcom-chart-color-foreground); background: var(--dotcom-chart-color-background); font: inherit; font-size: 14px; line-height: 1.5; }
      [data-dotcom-chart-data-view] dialog[open] { display: flex; flex-direction: column; gap: 16px; }
      [data-dotcom-chart-data-view] dialog::backdrop { background: #0006; }
      [data-dotcom-chart-data-view] header { display: flex; align-items: center; justify-content: space-between; gap: 16px; flex-shrink: 0; }
      [data-dotcom-chart-data-view] h2 { margin: 0; font: inherit; font-size: 18px; font-weight: 600; }
      [data-dotcom-chart-data-view] :is(button,input) { box-sizing: border-box; font: inherit; color: inherit; }
      [data-dotcom-chart-data-view] button { min-height: 44px; border: 0; border-radius: 6px; background: transparent; cursor: pointer; }
      [data-dotcom-chart-data-view] button:hover { background: var(--dotcom-chart-color-menu-item-focus-background, #8881); }
      [data-dotcom-chart-data-view] :is(button,input):focus-visible { outline: 2px solid currentColor; outline-offset: 2px; }
      [data-dotcom-chart-data-view] header button { width: 44px; flex-shrink: 0; display: grid; place-items: center; }
      [data-dotcom-chart-data-view] [data-scroll] { overflow: auto; min-height: 0; padding: 2px; }
      [data-dotcom-chart-data-view] p { margin: 0 0 16px; color: var(--dotcom-chart-color-muted-foreground); }
      [data-dotcom-chart-data-view] label { display: flex; flex-direction: column; gap: 8px; margin-bottom: 16px; }
      [data-dotcom-chart-data-view] input { width: 100%; min-height: 44px; padding: 8px 12px; font-size: 16px; border: 1px solid var(--dotcom-chart-color-control-border, #8886); border-radius: 8px; background: transparent; }
      [data-dotcom-chart-data-view] table { width: 100%; table-layout: fixed; border-collapse: collapse; }
      [data-dotcom-chart-data-view] :is(th,td) { padding: 8px; text-align: end; border-bottom: 1px solid var(--dotcom-chart-color-control-border, #8884); overflow-wrap: anywhere; font-variant-numeric: tabular-nums; }
      [data-dotcom-chart-data-view] :is(th,td):first-child { width: 64%; padding-inline-start: 0; text-align: start; }
