{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "onedrive",
  "version": "1.1.0",
  "description": "Secure OneDrive access through the registered CloudStorage Portal connection.",
  "author": {
    "name": "Zilvereyes",
    "email": "zilver.muhlig.hansen@gmail.com"
  },
  "license": "MIT",
  "keywords": [
    "onedrive",
    "microsoft-graph",
    "cloud-storage",
    "files"
  ],
  "extensions": {
    "com.openai": {
      "apps": "./.app.json",
      "interface": {
        "displayName": "OneDrive",
        "shortDescription": "Registered OneDrive connection",
        "longDescription": "OneDrive file operations through the hosted Microsoft Graph broker. CloudStorage Portal uses this same App; no separate Local runtime is required.",
        "developerName": "Zilvereyes",
        "category": "Productivity",
        "websiteURL": "https://github.com/WinRecoveryProject/CloudStorage-Portal",
        "privacyPolicyURL": "https://github.com/WinRecoveryProject/PluginMarketplace/blob/main/docs/cloudstorage-privacy.md",
        "termsOfServiceURL": "https://github.com/WinRecoveryProject/PluginMarketplace/blob/main/docs/cloudstorage-terms.md",
        "capabilities": [],
        "defaultPrompt": "Vis min verificerede OneDrive-konto og indholdet i roden uden at ændre filer.",
        "logo": "./assets/onedrive.png",
        "composerIcon": "./assets/onedrive.png",
        "brandColor": "#0078D4",
        "brandColorDark": "#4CC2FF"
      }
    }
  }
}
